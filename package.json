    "bootstrap:po-groups": "node scripts/bootstrap-product-owner-groups.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "7.1.0-dev.20260809.1",
    "wrangler": "4.62.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
