{
  "name": "onething-slack-garden",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir .output",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy-production-worker.mjs",
    "deploy:log-alerts": "node scripts/deploy-log-alert-worker.mjs",
    "test:unit": "node scripts/test-unit.mjs",
