BUG_RUNNER_DATABASE_URL=
SLACK_TEAM_ID=T_REPLACE
CODEX_ENVIRONMENT_ID=REPLACE_ENVIRONMENT_ID
CODEX_BASE_BRANCH=main
CODEX_REPOSITORY_URL=https://github.com/REPLACE_OWNER/REPLACE_REPOSITORY.git
BUG_RUNNER_ROOT=/home/REPLACE_USER/.local/state/otl1-bug-runner
CODEX_ACCOUNT_ALIAS=primary
BUG_RUNNER_WORKER_ID=genquant-primary
BUG_DEPLOY_CHECKOUT=/home/REPLACE_USER/otl1-bug-runner/current
BUG_DEPLOY_SERVICE=otl1-bug-runner.service
BUG_DEPLOY_WORKER_ID=genquant-deployer
# Open events Worker deployment broker. Keep the token in the mode-0600 runtime env only.
CLOUDFLARE_API_TOKEN=
OTL1_OPEN_EVENTS_WRANGLER_CONFIG=/home/REPLACE_USER/otl1-bug-runner/current/.wrangler.open-events.json
BUG_DEPLOY_OPEN_EVENTS_HEALTH_URL=https://replace-events-worker.workers.dev/health
# Founder-approved Core Worker code. Migrations and site changes remain fail-closed/manual.
OTL1_PRODUCTION_WRANGLER_CONFIG=/home/REPLACE_USER/otl1-bug-runner/current/.wrangler.production.json
BUG_DEPLOY_CORE_HEALTH_URL=https://replace-core-worker.workers.dev/health
